# FPL Scouting System Configuration

# Telegram Bot Configuration (REQUIRED)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# FPL Account Configuration (REQUIRED for squad data and auto-trading)
# Option 1 (recommended): Email/password — auto-refreshes session every fetch cycle
FPL_EMAIL=your_fpl_email_here
FPL_PASSWORD=your_fpl_password_here
FPL_TEAM_ID=your_fpl_team_id_here

# Option 2 (fallback): Manual session cookie — expires periodically
# Get from browser: DevTools (F12) → Application → Cookies → pl_profile
FPL_SESSION_COOKIE=

# User Configuration
DEFAULT_USER_ID=default

# Scheduling (cron format)
# Fetch data every 1 hour
FETCH_SCHEDULE=0 */1 * * *

# Bot Configuration
# How often to check for new recommendations (in minutes)
CHECK_INTERVAL_MINUTES=60
# Enable debug logging
BOT_DEBUG=false
